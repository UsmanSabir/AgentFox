<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentFox</RootNamespace>
    <AssemblyName>AgentFox</AssemblyName>
    <Version>1.0.0</Version>
    <Description>AgentFox - Multi-agent framework with sub-agents, memory, MCP support, and channel integrations</Description>

    <!-- Single-file publish: framework-dependent, platform-specific RID required -->
    <!-- Usage: dotnet publish -c Release -r win-x64 -p:PublishSingleFile=true -->
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Bundle native libs (e_sqlite3.dll, onnxruntime*.dll) INTO the single exe;
         they self-extract to a temp dir at runtime. Without this they remain loose
         files next to the exe and a bare exe throws DllNotFoundException. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Required for ManifestEmbeddedFileProvider to serve wwwroot from inside the exe -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json" />
  </ItemGroup>

  <!-- ── Frontend static files ──────────────────────────────────────────────
       Embed wwwroot into the assembly so dotnet publish produces a single exe.
       Uncomment after running: cd src/frontend && npm run build
       Then publish with: dotnet publish -c Release -r win-x64 -p:PublishSingleFile=true
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>
  ──────────────────────────────────────────────────────────────────────────── -->

  <!-- ── Auto-build frontend before dotnet build (optional hook) ───────────
       Uncomment to have MSBuild run "npm run build" automatically.
       Requires Node.js + npm in PATH. Manual build is recommended for dev.
  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild">
    <Message Text="Building SvelteKit frontend..." Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\frontend" />
  </Target>
  ──────────────────────────────────────────────────────────────────────────── -->
  
  <ItemGroup>
	  <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
	  <PackageReference Include="Google.GenAI" Version="1.14.0" />
	  <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.13.0-preview.260703.1" />
	  <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.13.0" />
	  <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.0" />
	  <PackageReference Include="Spectre.Console" Version="0.57.2" />
	  <PackageReference Include="Microsoft.Agents.AI" Version="1.13.0" />
	  <PackageReference Include="Microsoft.Agents.AI.Anthropic" Version="1.0.0-rc5" />
	  <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.13.0" />
	  <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
	  <PackageReference Include="OllamaSharp" Version="5.4.27" />
	  <PackageReference Include="OpenAI" Version="2.12.0" />

	  <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
	  <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
	  <!-- Microsoft.Data.Sqlite allows an older vulnerable native bundle; pin the maintained release. -->
	  <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	  <PackageReference Include="YamlDotNet" Version="18.1.0" />
	  <PackageReference Include="ModelContextProtocol.Core" Version="1.4.1" />
	  <PackageReference Include="Discord.Net" Version="3.20.1" />
	  <!-- Serves wwwroot embedded in the assembly for single-file publish -->
	  <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\AgentFox.Plugins\AgentFox.Plugins.csproj">
	  </ProjectReference>
    <ProjectReference Include="..\LocalEmbeddings\LocalEmbeddings.csproj" />
  </ItemGroup>

  <ItemGroup>
      <Content Update="appsettings.json">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <Content Update="appsettings.*.json" Condition="Exists('appsettings.*.json')">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
          <DependentUpon>appsettings.json</DependentUpon>
      </Content>
  </ItemGroup>

</Project>
