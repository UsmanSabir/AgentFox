<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentFox</RootNamespace>
    <AssemblyName>AgentFox</AssemblyName>
    <!-- Base version. The CI release workflow (.github/workflows/release.yml) overrides
         Version / InformationalVersion per build to auto-increment
         (e.g. 1.0.<run_number>+<sha>). Local builds use this value as-is.
         Bump MAJOR.MINOR here; the CI patch component comes from the build run number. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- Keep InformationalVersion exactly as set (CI passes "x.y.z+sha"); without this
         the SDK auto-appends the full git commit, producing a messy double suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>AgentFox - Multi-agent framework with sub-agents, memory, MCP support, and channel integrations</Description>

    <!-- Single-file publish: framework-dependent, platform-specific RID required -->
    <!-- Usage: dotnet publish -c Release -r win-x64 -p:PublishSingleFile=true -->
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Bundle native libs (e_sqlite3.dll, onnxruntime*.dll) INTO the single exe;
         they self-extract to a temp dir at runtime. Without this they remain loose
         files next to the exe and a bare exe throws DllNotFoundException. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Required for ManifestEmbeddedFileProvider to serve wwwroot from inside the exe -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dev-only overrides. Gitignored (appsettings.*.json), so absent in CI/prod.
         Condition keeps it in local dev builds (file present) and skips it in
         release/CI builds (file absent) instead of failing MSB3030 on copy. -->
    <Content Include="appsettings.Development.json"
              Condition="Exists('$(MSBuildProjectDirectory)\appsettings.Development.json')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <!-- The source file remains conveniently named appsettings.json for development, but
         releases install it as defaults. User changes live in appsettings.user.json. -->
    <Content Include="appsettings.json">
      <Link>appsettings.defaults.json</Link>
      <TargetPath>appsettings.defaults.json</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- ── Frontend static files ──────────────────────────────────────────────
       Embed wwwroot into the assembly so dotnet publish produces a single exe.
       Populate wwwroot first with: cd src/frontend && npm ci && npm run build
       (SvelteKit static adapter outputs to ../Agent/wwwroot). The condition means
       a build without a compiled frontend still succeeds — nothing is embedded and
       the web UI is simply absent, served from disk in dev if present. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <!-- ── Auto-build frontend before dotnet build (optional hook) ───────────
       Uncomment to have MSBuild run "npm run build" automatically.
       Requires Node.js + npm in PATH. Manual build is recommended for dev.
  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild">
    <Message Text="Building SvelteKit frontend..." Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\frontend" />
  </Target>
  ──────────────────────────────────────────────────────────────────────────── -->
  
  <ItemGroup>
	  <PackageReference Include="Azure.AI.OpenAI" />
	  <PackageReference Include="Google.GenAI" />
	  <PackageReference Include="Microsoft.Agents.AI.Harness" />
	  <PackageReference Include="Microsoft.Agents.AI.Workflows" />
	  <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
	  <PackageReference Include="Spectre.Console" />
	  <PackageReference Include="Microsoft.Agents.AI" />
	  <PackageReference Include="Microsoft.Agents.AI.Anthropic" />
	  <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
	  <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	  <PackageReference Include="OllamaSharp" />
	  <PackageReference Include="OpenAI" />
	  <PackageReference Include="PrettyPrompt" />

	  <PackageReference Include="Microsoft.Extensions.Configuration" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	  <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
	  <PackageReference Include="Microsoft.Extensions.Logging" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Console" />
	  <PackageReference Include="Microsoft.Data.Sqlite" />
	  <!-- Microsoft.Data.Sqlite allows an older vulnerable native bundle; pin the maintained release. -->
	  <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
	  <PackageReference Include="Newtonsoft.Json" />
	  <PackageReference Include="YamlDotNet" />
	  <PackageReference Include="Cronos" />
	  <PackageReference Include="ModelContextProtocol.Core" />
	  <PackageReference Include="Discord.Net" />
	  <!-- Serves wwwroot embedded in the assembly for single-file publish -->
	  <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\AgentFox.Plugins\AgentFox.Plugins.csproj">
	  </ProjectReference>
    <ProjectReference Include="..\LocalEmbeddings\LocalEmbeddings.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
