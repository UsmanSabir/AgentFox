{
  "ConfigSchemaVersion": 1,
  "UI": {
    "RenderReasoning": true
  },
  "Web": {
    "ManagementAuth": {
      "Enabled": false,
      "HeaderName": "X-AgentFox-Api-Key",
      "ApiKeys": []
    }
  },
  "Services": {
    "Enabled": true,
    "ServiceName": "AgentFox",
    "DisplayName": "AgentFox - Multi-Agent AI Framework",
    "Description": "Multi-agent AI framework running in web mode with agent processing, memory, scheduling, and MCP support.",
    "Port": 8080,
    "RunAsAdmin": true,
    "AutoStart": true,
    "LogPath": "{workspace}/logs/service.log",
    "HeartbeatIntervalSeconds": 5,
    "EnvironmentVariables": {}
  },
  "Modules": "cli,web,trading-agent,page-agent,brave-search,tavily-search,duckduckgo-search",
  "Logging": {
    "UseFileLogger": true,
    "FilePath": "logs/agentfox.log",
    "MinLevel": "Warning",
    "RetentionDays": 3
  },
  "LLM": {
    "Provider": "OpenAi",
    "ApiKey": "aaa",
    "Model": "qwen2.5-14b-instruct", // "google/gemma-4-12b" //"qwen/qwen3.6-27b", // "qwen2.5-14b-instruct",//    "openai/gpt-oss-20b\", // \"qwen/qwen3.5-9b\", //    \"qwen/qwen3.5-9b\\\", //   \\\"qwen3.5-27b-claude-4.6-opus-reasoning-distilled@q3_k_m\\\\\\\", // \\\\\\\"qwen3.5-27b-claude-4.6-opus-reasoning-distilled@q4_k_m\\\\\\\\\\\\\\\", //\\\\\\\\\\\\\\\"qwen/qwen3.5-9b\\\\\\\\\\\\\\\",\\\\\\\"\\\"\"",
    "BaseUrl": "http://192.168.100.50:1234/v1",
    "TimeoutSeconds": 3600,
    // Web-chat file attachments. Images and PDFs are offered only when the model can
    // actually read them, which is auto-detected from the model name above — set Images
    // or Documents explicitly to override that for a model the detector doesn't know.
    // Text and code files are always accepted (they are inlined into the prompt as text).
    "Attachments": {
      "Enabled": true,
      // "Images": true,
      // "Documents": true,
      "TextFiles": true,
      "MaxFileSizeMb": 10,
      "MaxFilesPerMessage": 5,
      "MaxTotalSizeMb": 20
    }
  },
  "Models": {
    "LM": {
      "Provider": "OpenAi",
      "ApiKey": "aaa",
      "Model": "qwen2.5-14b-instruct", //"qwen/qwen3.6-27b", // "qwen2.5-14b-instruct",//    "openai/gpt-oss-20b\", // \"qwen/qwen3.5-9b\", //    \"qwen/qwen3.5-9b\\\", //   \\\"qwen3.5-27b-claude-4.6-opus-reasoning-distilled@q3_k_m\\\\\\\", // \\\\\\\"qwen3.5-27b-claude-4.6-opus-reasoning-distilled@q4_k_m\\\\\\\\\\\\\\\", //\\\\\\\\\\\\\\\"qwen/qwen3.5-9b\\\\\\\\\\\\\\\",\\\\\\\"\\\"\"",
      "BaseUrl": "http://127.0.0.1:1234/v1",
      "TimeoutSeconds": 3600
    },
    "CheapModel": {
      "Provider": "Ollama",
      "Model": "phi4-mini",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 3600
    },
    "FastModel": {
      "Provider": "Ollama",
      "Model": "llama3.2",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 1800
    },
    "ReasoningModel": {
      "Provider": "Ollama",
      "Model": "deepseek-r1",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 7200
    },
    // "SubAgent": {                  // Optional: dedicated model for background sub-agents.
    //     "Provider": "Ollama",      // If omitted, sub-agents use the primary LLM (LLM section).
    //     "Model": "llama3.2",
    //     "BaseUrl": "http://localhost:11434",
    //     "TimeoutSeconds": 1800
    // },
    "Embedding": {
      "Provider": "Local", // "Local", "OpenAI", "Ollama", "None" (or omitted), it falls back to the existing BM25 search
      "Model": "text-embedding-all-minilm-l6-v2", // "text-embedding-3-small", //"nomic-embed-text", 
      "BaseUrl": "http://127.0.0.1:1234/v1", //"http://localhost:11434"
      "ApiKey": "something"
    }
  },

  "Memory": {
    "Enabled": true,
    "LongTermStorage": "Sqlite", //Sqlite or Markdown
    "MarkdownPath": "LongTermMemory.md",
    "SqlitePath": "LongTermMemory.db",
    "ModelRef": "Embedding"
  },
  "Compaction": {
    "Enabled": false,
    "TriggerThreshold": 400,
    "ToolResultThreshold": 400,
    "SummarizationThreshold": 800,
    "TruncationThreshold": 1200,
    "SummarizationModelKey": "LM"
  },
  "TodoPlanner": {
    "Enabled": true,
    "SuppressTodoListMessage": false,
    "MaxContinuations": 1, //0 — warn-only, 1–2 for headless/autonomous runs
    "PersistAcrossRestarts": true, // unfinished todos survive a crash/restart via {session}.md.state.json
    "StaleAfterHours": 1 // older than this, the agent asks before resuming recovered work
  },
  "Composio": {
    "ApiKey": "your-composio-api-key-here",
    "EnableDetailedLogging": false,
    "CacheTimeoutSeconds": 3600
  },
  "MCP": {
    "Servers": [
      {
        "Name": "example-http-server",
        "Enabled": false,
        "Transport": {
          "Type": "Http",
          "Url": "http://localhost:3000/mcp",
          "Headers": {
            "Authorization": "Bearer YOUR_TOKEN_HERE"
          }
        }
      },
      {
        "Name": "example-sse-server",
        "Enabled": false,
        "Transport": {
          "Type": "Sse",
          "Url": "http://localhost:3001/sse",
          "MaxReconnectionAttempts": 5
        }
      },
      {
        "Name": "example-stdio-server",
        "Enabled": false,
        "Transport": {
          "Type": "Stdio",
          "Command": "npx",
          "Arguments": [ "-y", "@modelcontextprotocol/server-filesystem", "C:\\workspace" ],
          "WorkingDirectory": "C:\\workspace",
          "Env": {
            "NODE_ENV": "production"
          },
          "ShutdownTimeoutSeconds": 5
        }
      }
    ]
  },
  "Hitl": {
    "Enabled": true,
    "RequireApprovalForTools": ["place_order", "place_orders"],
    "Bypass": {
      "AutoApproveAll": false,
      "ChannelIds": [],
      "ChannelTypes": [],
      "SessionOrigins": [],
      "Roles": []
    },

    // Expiry for the two blocking gates. The waiting command holds a lane slot the whole time, so
    // 0 ("wait forever") is only safe when a human is guaranteed to be watching.
    // ApprovalTimeoutSeconds: an unanswered approval expires and is treated as REJECTED.
    // QuestionTimeoutSeconds: an unanswered request_human_input returns "nobody answered".
    "ApprovalTimeoutSeconds": 1800,
    "QuestionTimeoutSeconds": 1800
  },
  "Plan": {
    "Enabled": false,
    "MutatingTools": []
  },

  // Optional Microsoft Agent Framework HarnessAgent profile (see HARNESS_AGENT_ROADMAP.md).
  // Disabled by default; capabilities are opt-in per named profile (main-safe,
  // trading-research, developer-sandbox) and default to least privilege.
  "Harness": {
    "Enabled": false,
    "DefaultProfile": "main-safe"
  },
  "Sessions": {
    "IdleTimeoutMinutes": 30,
    "ArchiveRetentionDays": 30,
    "SessionDirectory": "sessions",
    "ArchiveDirectory": "archive/sessions",
    "BackgroundCheckIntervalSeconds": 60
  },
  "RestrictToWorkspace": true,
  "Workspaces": [],

  // Credential guard. Keeps API keys out of model context and chat: credential files
  // (appsettings*.json, .env, *.plugin-config.json, SSH/cloud stores) are unreadable by tools,
  // environment-dumping commands are refused, child processes start without secret variables,
  // and every tool result is scrubbed of live secret values on the way back to the model.
  "Security": {
    // Turning this off lets API keys flow into model context and transcripts. Leave it on.
    "Enabled": true,
    // Strip credential-shaped variables from processes the shell / code tools launch.
    "SanitizeChildProcessEnvironment": true,
    // Variables to keep in child processes anyway (e.g. "GH_TOKEN" for gh CLI work).
    // Each entry re-opens a leak path — add only what a tool genuinely needs.
    "ChildProcessEnvironmentAllowlist": [],
    // Extra file names or absolute paths to treat as credential stores.
    "AdditionalProtectedPaths": [],
    // Extra config/environment name fragments that identify a secret.
    "AdditionalSecretNames": []
  },

  // Messaging channels. Two optional keys on every entry, whatever the Type:
  //
  //   "Name"      A stable id for this channel. Optional with one channel per type; REQUIRED to
  //               run two of the same type, because providers mint ids from the type and would
  //               otherwise collide. Subscriptions are stored against it.
  //
  //   "Subscribe" Which notification topics this channel receives. Omit for all of them.
  //               Filters are comma-separated; an array (["a.>", "b.>"]) works too.
  //                 *   matches exactly one segment
  //                 >   matches one or more trailing segments — must be the last segment
  //               So "trading.*" matches trading.order but NOT trading.order.accepted, while
  //               "trading.>" matches both, and a bare ">" matches everything.
  //               A filter matching no published topic is silent, not an error — see the topic
  //               list on the Channels page in the web UI for what is actually published.
  //               hitl.* traffic ignores filtering when nothing subscribes to it: those are
  //               questions the agent blocks on, so they always reach someone.
  "Channels": [
    {
      "Type": "Telegram",
      "Enabled": false,
      "BotToken": "your-telegram-bot-token-here",
      "PollingTimeoutSeconds": 30,
      "ChatId": "your-telegram-chat-id-here"
    },
    {
      "Type": "Discord",
      "Enabled": false,
      "BotToken": "your-discord-bot-token-here",
      "GuildId": "server-id",
      "DefaultChannelId": "channel-id-here"
    },
    {
      // Test channel: no credentials, sends nothing, records what it was asked to deliver.
      // Enable it to check a subscription filter without a real transport — cause the event, then
      // read GET /channels/test/messages. Works the same added at runtime via
      // manage_channel action=add channel_type=dummy.
      "Type": "Dummy",
      "Name": "test",
      "Enabled": true,
      "Capacity": 50,
      "Subscribe": ">"
    }
    // Add more channels here — same Type can appear multiple times, given distinct Names:
    // { "Type": "Telegram", "Name": "tg-orders", "Enabled": true, "BotToken": "...",
    //   "ChatId": "...", "Subscribe": "trading.order.>" },
    // { "Type": "Telegram", "Name": "tg-ops", "Enabled": true, "BotToken": "...",
    //   "ChatId": "...", "Subscribe": "hitl.>, agent.>" },
    // { "Type": "Discord",  "Enabled": true, "BotToken": "...", "GuildId": "...", "DefaultChannelId": "..." }
  ],

  // Tool groups — set any to false to skip registration.
  // Useful profiles:
  //   Docker / sandboxed : Shell=false, FileSystem=false, SystemInfo=false
  //   Read-only agent    : Shell=false, Disabled=["write_file","delete","make_directory"]
  "Tools": {
    "Shell": true,
    "FileSystem": true,
    "Web": true,
    "Utilities": true,
    "SystemInfo": true,
    "Memory": true,
    "SubAgent": true,
    "Scheduling": true,
    "Channels": true,
    "Mcp": true,
    "Disabled": [],

    // Execution ceilings. A tool call runs inside a command, a command holds a lane slot, and the
    // Main lane is serial — so an unbounded tool is an unbounded freeze of the interactive prompt.
    // TimeoutSeconds: ceiling on any one tool call (0 disables). On expiry the turn stops waiting
    //   and the model gets a failed tool call. request_human_input and submit_plan are exempt —
    //   waiting on a human is their job, and they expire on the Hitl timeouts below.
    // ShellTimeoutSeconds: ceiling inside the shell tool itself, so the child process tree is
    //   actually killed rather than merely abandoned. Keep it below TimeoutSeconds.
    "TimeoutSeconds": 300,
    "ShellTimeoutSeconds": 120,

    // notify_user delivery guards.
    // SubAgentNotify: let a sub-agent post to the user's channels itself. Off by default — its
    //   result goes back to the parent, which decides what the user sees. Turning this on means a
    //   parent that delegates "gather the data and post the update" delivers it twice.
    // DuplicateNotifyWindowSeconds: within one session, a near-identical message inside this
    //   window is treated as a resend and suppressed (0 disables). Catches auto-continuations and
    //   stale todo items re-delivering the same report.
    "SubAgentNotify": false,
    "DuplicateNotifyWindowSeconds": 300,
    "DuplicateNotifyThreshold": 0.9
  },

  "Plugins": {
    "TradingAgent": {
      "AutoExecute": true,
      "ExecutionMode": "BoundedAuto", // Disabled, Paper, Shadow, ApprovalRequired, or BoundedAuto
      "MinConfidence": "HIGH",
      //"ParserModelKey": "LM",
      "MemoryMode": "Shared", // Shared, Isolated, or Disabled
      "DuplicateWindowMinutes": 60,
      "AutoPlaceTargetSell": true, // pair a take-profit SELL with a BUY that gives a target
      "AutoBuyWithoutEntryPrice": false, // true → resolve live price for "accumulate on dips" tips; false → log only
      // true → refuse an order that omits 'quantity' instead of sizing it from Ahk.PerStockBudgetPkr.
      // Turn ON when the caller should always state sizes (live testing, or a small local model):
      // a model told to place 10 shares once omitted the argument and budget-sizing produced 75.
      "RequireExplicitQuantity": false,
      "DatabasePath": "trading/trading.db",
      "MarketHolidays": [],
      "MarketSessionOverrides": [],
      "FailClosedOnCalendarError": true,
      "RequireSignedWebhooks": true,
      "KillSwitch": false,
      // AllowedSymbols (default) keeps execution configuration-only. Watchlist makes the editable
      // watchlist the execution universe; every order still crosses all deterministic safety gates.
      "ExecutionUniverseSource": "Watchlist",
      "AllowedSymbols": [
        "OGDC",
        "PPL",
        "HUBC",
        "ATRL",
        "PRL",
        "MARI",
        "MEBL",
        "NML",
        "PAEL",
        "NETSOL",
        "POL",
        "FFC",
        "FATIMA",
        "LUCK",
        "BWCL",
        "MLCF",
        "DGKC",
        "SYS",
        "ATLH",
        "PSO",
        "NRL",
        "PIOC",
        "APL",
        "GLAXO",
        "FABL",
        "ENGROH",
        "SELECT",
        "GHNI",
        "GAL",
        "SAZEW"
      ], // fail closed until explicitly configured
      // Symbols you trade BY HAND: no automation may originate an order for them, entries or exits,
      // and you still can. Not a subset of AllowedSymbols to remove — that would ban you too. The
      // per-symbol toggle on each watchlist row adds to this list; nothing can remove from it.
      "ManualOnlySymbols": [],
      "RequireConfiguredSymbols": true,
      "MaxOrdersPerBatch": 10,
      "MaxBatchValuePkr": 250000,
      "RequireReconciliationHealthy": false,
      "ReconciliationIntervalSeconds": 60,
      "ReconciliationMaxAgeSeconds": 180,
      "ResearchWebEnabled": true,
      "ResearchWebMaxResults": 5,
      "ResearchWebSearchDepth": "advanced",
      "ResearchWebMaxContentCharacters": 4000
    },
    "Ahk": {
      "Headless": false, // false to watch the browser
      "ExecutablePath": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", // empty → auto-download Chromium
      "AllowMarketOrders": false, // true to permit price-less market orders
      "OrderConfirmTimeoutMs": 8000,

      "PortalUrl": "https://web.ahletrade.com/",
      "Username": "",
      "Password": "",
      "TradingPin": "",
      "DefaultQty": 100,
      "MaxOrderValuePkr": 50000, // hard ceiling: any order whose value exceeds this is rejected
      "PerStockBudgetPkr": 50000, // target spend per stock when a signal gives no explicit quantity
      "BudgetBufferPercent": 2, // headroom (%) held back for fees/price drift when budget-sizing
      "DipDiscountPercent": 1, // for no-entry-price BUYs: place the limit this % below the live price
      "ClampPriceToBand": true, // clamp a limit into the day's Lower Lock / Upper Cap (e.g. take-profit above cap)

      // Which market states accept orders. Prefer the BROKER's reported state over the local
      // 09:32-15:30 calendar, so the pre-open OHO window (orders queue for the open) is usable and
      // an unscheduled halt is respected. Leave the list EMPTY to use the defaults OPEN/OPN/OHO --
      // .NET's config binder APPENDS to a pre-populated list, so listing them here would duplicate.
      "TrustBrokerMarketState": true,
      "OrderAcceptingMarketStates": [],
      "CancelVerifyTimeoutMs": 30000, // how long a cancel is given to leave the order book (~2s typical)
      "SessionDir": "session_ahk",
      "LogDir": "logs/trading",
      // LOGIN is distinct from /Home/Relogin keepalive. All callers share this cooldown and
      // exponential failure backoff so an outage or broker block cannot create a login storm.
      "MinimumLoginIntervalSeconds": 600,
      "LoginRetryInitialSeconds": 60,
      "LoginRetryMaxSeconds": 900
    },
    "AhkFeed": {
      // Live quotes straight from the broker portal's own feed (GET /Home/GetFeed) instead of the
      // PSX data portal. Off by default: it needs a live broker session, so enabling it keeps an
      // authenticated session warm. With it off, everything falls back to the PSX market watch
      // exactly as before. See Plugins/TradingAgent/docs/ahk-feed-api.md.
      // ON. Verified live end to end (session, subscription, quotes reaching consumers, watchlist
      // sync). It requests the session during market hours; once requested, the dedicated lifecycle
      // worker keeps that same session warm and only logs in again after confirmed expiry. Turning the
      // feed off is safe and falls back to the PSX market watch, losing freshness and bid/ask.
      //
      // RATE LIMITING: the broker briefly blocked account access on 2026-08-18. The suspected cause
      // was ~15 browser logins in two hours from repeatedly RESTARTING the host, not this poll
      // (which matches the portal's own 1-2s cadence). Start the host once and leave it running.
      // For order-only work against a rate-sensitive account, set this false - the whole
      // place/read/cancel/verify cycle is then ~7 requests with nothing polling in the background.
      "Enabled": true,
      "PollSeconds": 2, // the portal's own UI polls every 1-2s; NEVER go below this
      "ReloginSeconds": 60,
      "SymbolsPerPage": 50, // the portal's own page size
      "Pages": [ "Page1", "Page2", "Page3", "Page4" ], // 4 x 50 = 200 symbols of capacity
      "Market": "REG", // regular board; ODL is odd-lot and prices differ
      "MaxQuoteAgeSeconds": 600, // past this a quote is stale and PSX covers the symbol instead
      "UnhealthyAfterConsecutiveFailures": 5,
      "OnlyDuringMarketHours": true,
      "PrePostMarketMinutes": 30,
      // Market depth (MBP = ladder by price, MBO = individual orders). This is the ONLY depth source
      // available - the AHL analytics portal has none. Rows ride along on the GetFeed response the
      // quote feed already polls, so depth costs no extra traffic once subscribed.
      //
      // OFF by default. One symbol at a time, matching the portal's own UI (a single MBO panel and a
      // single MBP panel), so this is per-symbol focus, not a watchlist-wide feed.
      "DepthEnabled": false,
      // DANGER: pagenum is ONE namespace shared by every feed type, and a subscription REPLACES the
      // slot. Putting depth on a page listed in "Pages" above evicts that page's quote symbols, and
      // the portal reports nothing - GetFeed answers 200 with an empty array whether nothing traded
      // or nothing is subscribed, so the only symptom is quotes silently stopping. The subscription
      // is refused outright on overlap. Page5 was verified live on 2026-08-20: the plugin received
      // 10 MBP and 10 MBO rows for PPL while all 30 quote symbols on Page1 stayed fresh.
      "DepthPage": "Page5"
    },
    "AhlAnalytics": {
      // The AHL RESEARCH portal (data.arifhabibltd.com) - a separate product from the trading
      // terminal, reached by an SSO handshake through the broker session. Read-only: whole-market
      // snapshots (857 equities in one call), 5 years of daily candles, native 1-minute intraday,
      // fundamentals with sector medians, event calendars, insider dealing, AHL's own analyst notes.
      //
      // It carries NO order path and NO L2 depth - every order-book endpoint 500s and its websocket
      // exposes best bid/ask only. Depth and execution stay with AhkFeed. See
      // Plugins/TradingAgent/docs/ahl-analytics-api.md for the captured protocol.
      //
      // ON. A cold polled caller never launches a broker LOGIN. Once AhkFeed has already established
      // the broker session, the dashboard may use that existing session for the cheap AHL SSO hop;
      // failed handshakes still open a cooldown. Turning this off is always safe: candles fall back
      // to PSX and the movers/dossier tools report themselves disabled.
      "Enabled": true,
      "SnapshotCacheSeconds": 60, // the snapshot is ~1.1 MB; every movers screen sorts this one copy
      // Daily bars change once per session. Cache per symbol so a 30-symbol monitoring pass does not
      // consume 30 of the portal's 40 requests every two minutes and starve the snapshot POST.
      "DailyCandleCacheMinutes": 720,
      "TokenLifetimeHours": 72,   // the token itself lasts ~a year; this just bounds silent revocation
      // The portal answers X-RateLimit-Limit: 60 but punishes a burst with 401 (not 429). Stay under,
      // and leave headroom for an operator's own browser session sharing the quota.
      "MaxRequestsPerMinute": 40,
      // The portal's precomputed /indicators disagrees with values computed from its own candles
      // (MACFL 2026-08-19: CCI -34.27 there vs 215.23 computed). Its own UI computes from candles.
      "PreferPortalIndicators": false
    },
    "BraveSearch": {
      "ApiKey": "",
      "MaxResults": 5
    },
    "Tavily": {
      "ApiKey": "",
      "SearchDepth": "advanced", // "basic" or "advanced"
      "MaxResults": 5,
      "IncludeAnswer": true
    },
    "PageAgent": {
      "Headless": false,
      "UseSystemProfile": true,
      "UseProfileCopy": false,
      "KillConflictingBrowser": true,
      "UserDataDir": "C:\\Users\\YourName\\AppData\\Local\\Google\\Chrome\\User Data"
    }
  }

}
