{
  "ConfigSchemaVersion": 1,
  "UI": {
    "RenderReasoning": true
  },
  "Web": {
    "ManagementAuth": {
      "Enabled": false,
      "HeaderName": "X-AgentFox-Api-Key",
      "ApiKeys": []
    }
  },
  "Services": {
    "Enabled": true,
    "ServiceName": "AgentFox",
    "DisplayName": "AgentFox - Multi-Agent AI Framework",
    "Description": "Multi-agent AI framework running in web mode with agent processing, memory, scheduling, and MCP support.",
    "Port": 8080,
    "RunAsAdmin": true,
    "AutoStart": true,
    "LogPath": "{workspace}/logs/service.log",
    "HeartbeatIntervalSeconds": 5,
    "EnvironmentVariables": {}
  },
  "Modules": "cli,web,trading-agent,page-agent,brave-search,tavily-search,duckduckgo-search",
  "Logging": {
    "UseFileLogger": true,
    "FilePath": "logs/agentfox.log",
    "MinLevel": "Warning",
    "RetentionDays": 3
  },
  "LLM": {
    "Provider": "Ollama",
    "Model": "llama3.2",
    "BaseUrl": "http://localhost:11434",
    "TimeoutSeconds": 3600,
    "Headers": {
      "a": "b"
    }
  },
  "Models": {
    "LM": {
      "Provider": "OpenAi",
      "ApiKey": "aaa",
      "Model": "qwen2.5-14b-instruct", //"qwen/qwen3.6-27b", // "qwen2.5-14b-instruct",//    "openai/gpt-oss-20b\", // \"qwen/qwen3.5-9b\", //    \"qwen/qwen3.5-9b\\\", //   \\\"qwen3.5-27b-claude-4.6-opus-reasoning-distilled@q3_k_m\\\\\\\", // \\\\\\\"qwen3.5-27b-claude-4.6-opus-reasoning-distilled@q4_k_m\\\\\\\\\\\\\\\", //\\\\\\\\\\\\\\\"qwen/qwen3.5-9b\\\\\\\\\\\\\\\",\\\\\\\"\\\"\"",
      "BaseUrl": "http://127.0.0.1:12434/v1",
      "TimeoutSeconds": 3600
    },
    "CheapModel": {
      "Provider": "Ollama",
      "Model": "phi4-mini",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 3600
    },
    "FastModel": {
      "Provider": "Ollama",
      "Model": "llama3.2",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 1800
    },
    "ReasoningModel": {
      "Provider": "Ollama",
      "Model": "deepseek-r1",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 7200
    },
    // "SubAgent": {                  // Optional: dedicated model for background sub-agents.
    //     "Provider": "Ollama",      // If omitted, sub-agents use the primary LLM (LLM section).
    //     "Model": "llama3.2",
    //     "BaseUrl": "http://localhost:11434",
    //     "TimeoutSeconds": 1800
    // },
    "Embedding": {
      "Provider": "Local", // "Local", "OpenAI", "Ollama", "None" (or omitted), it falls back to the existing BM25 search
      "Model": "text-embedding-all-minilm-l6-v2", // "text-embedding-3-small", //"nomic-embed-text", 
      "BaseUrl": "http://127.0.0.1:1234/v1", //"http://localhost:11434"
      "ApiKey": "something"
    }
  },

  "Memory": {
    "Enabled": true,
    "LongTermStorage": "Sqlite", //Sqlite or Markdown
    "MarkdownPath": "LongTermMemory.md",
    "SqlitePath": "LongTermMemory.db",
    "ModelRef": "Embedding"
  },
  "Compaction": {
    "Enabled": false,
    "TriggerThreshold": 400,
    "ToolResultThreshold": 400,
    "SummarizationThreshold": 800,
    "TruncationThreshold": 1200,
    "SummarizationModelKey": "LM"
  },
  "Composio": {
    "ApiKey": "your-composio-api-key-here",
    "EnableDetailedLogging": false,
    "CacheTimeoutSeconds": 3600
  },
  "MCP": {
    "Servers": [
      {
        "Name": "example-http-server",
        "Enabled": false,
        "Transport": {
          "Type": "Http",
          "Url": "http://localhost:3000/mcp",
          "Headers": {
            "Authorization": "Bearer YOUR_TOKEN_HERE"
          }
        }
      },
      {
        "Name": "example-sse-server",
        "Enabled": false,
        "Transport": {
          "Type": "Sse",
          "Url": "http://localhost:3001/sse",
          "MaxReconnectionAttempts": 5
        }
      },
      {
        "Name": "example-stdio-server",
        "Enabled": false,
        "Transport": {
          "Type": "Stdio",
          "Command": "npx",
          "Arguments": [ "-y", "@modelcontextprotocol/server-filesystem", "C:\\workspace" ],
          "WorkingDirectory": "C:\\workspace",
          "Env": {
            "NODE_ENV": "production"
          },
          "ShutdownTimeoutSeconds": 5
        }
      }
    ]
  },
  "Hitl": {
    "Enabled": true,
    "RequireApprovalForTools": ["place_order", "place_orders"],
    "Bypass": {
      "AutoApproveAll": false,
      "ChannelIds": [],
      "ChannelTypes": [],
      "SessionOrigins": [],
      "Roles": []
    }
  },
  "Plan": {
    "Enabled": false,
    "MutatingTools": []
  },

  // Optional Microsoft Agent Framework HarnessAgent profile (see HARNESS_AGENT_ROADMAP.md).
  // Disabled by default; capabilities are opt-in per named profile (main-safe,
  // trading-research, developer-sandbox) and default to least privilege.
  "Harness": {
    "Enabled": false,
    "DefaultProfile": "main-safe"
  },
  "Sessions": {
    "IdleTimeoutMinutes": 30,
    "ArchiveRetentionDays": 30,
    "SessionDirectory": "sessions",
    "ArchiveDirectory": "archive/sessions",
    "BackgroundCheckIntervalSeconds": 60
  },
  "RestrictToWorkspace": true,
  "Workspaces": [],
  "Channels": [
    {
      "Type": "Telegram",
      "Enabled": false,
      "BotToken": "your-telegram-bot-token-here",
      "PollingTimeoutSeconds": 30,
      "ChatId": "your-telegram-chat-id-here"
    },
    {
      "Type": "Discord",
      "Enabled": false,
      "BotToken": "your-discord-bot-token-here",
      "GuildId": "server-id",
      "DefaultChannelId": "channel-id-here"
    }
    // Add more channels here — same Type can appear multiple times:
    // { "Type": "Telegram", "Enabled": true, "BotToken": "second-bot-token", ... },
    // { "Type": "Discord",  "Enabled": true, "BotToken": "...", "GuildId": "...", "DefaultChannelId": "..." }
  ],

  // Tool groups — set any to false to skip registration.
  // Useful profiles:
  //   Docker / sandboxed : Shell=false, FileSystem=false, SystemInfo=false
  //   Read-only agent    : Shell=false, Disabled=["write_file","delete","make_directory"]
  "Tools": {
    "Shell": true,
    "FileSystem": true,
    "Web": true,
    "Utilities": true,
    "SystemInfo": true,
    "Memory": true,
    "SubAgent": true,
    "Scheduling": true,
    "Channels": true,
    "Mcp": true,
    "Disabled": []
  },

  "Plugins": {
    "TradingAgent": {
      "AutoExecute": true,
      "ExecutionMode": "BoundedAuto", // Disabled, Paper, Shadow, ApprovalRequired, or BoundedAuto
      "MinConfidence": "HIGH",
      //"ParserModelKey": "LM",
      "MemoryMode": "Shared", // Shared, Isolated, or Disabled
      "DuplicateWindowMinutes": 60,
      "AutoPlaceTargetSell": true, // pair a take-profit SELL with a BUY that gives a target
      "AutoBuyWithoutEntryPrice": false, // true → resolve live price for "accumulate on dips" tips; false → log only
      "DatabasePath": "trading/trading.db",
      "MarketHolidays": [],
      "MarketSessionOverrides": [],
      "FailClosedOnCalendarError": true,
      "RequireSignedWebhooks": true,
      "KillSwitch": false,
      "AllowedSymbols": [], // fail closed until explicitly configured
      "RequireConfiguredSymbols": true,
      "MaxOrdersPerBatch": 10,
      "MaxBatchValuePkr": 250000,
      "RequireReconciliationHealthy": false,
      "ReconciliationIntervalSeconds": 60,
      "ReconciliationMaxAgeSeconds": 180,
      "ResearchWebEnabled": true,
      "ResearchWebMaxResults": 5,
      "ResearchWebSearchDepth": "advanced",
      "ResearchWebMaxContentCharacters": 4000
    },
    "Ahk": {
      "Headless": false, // false to watch the browser
      "ExecutablePath": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", // empty → auto-download Chromium
      "AllowMarketOrders": false, // true to permit price-less market orders
      "OrderConfirmTimeoutMs": 8000,

      "PortalUrl": "https://web.ahletrade.com/",
      "Username": "",
      "Password": "",
      "TradingPin": "",
      "DefaultQty": 100,
      "MaxOrderValuePkr": 50000, // hard ceiling: any order whose value exceeds this is rejected
      "PerStockBudgetPkr": 50000, // target spend per stock when a signal gives no explicit quantity
      "BudgetBufferPercent": 2, // headroom (%) held back for fees/price drift when budget-sizing
      "DipDiscountPercent": 1, // for no-entry-price BUYs: place the limit this % below the live price
      "ClampPriceToBand": true, // clamp a limit into the day's Lower Lock / Upper Cap (e.g. take-profit above cap)
      "SessionDir": "session_ahk",
      "LogDir": "logs/trading"
    },
    "BraveSearch": {
      "ApiKey": "",
      "MaxResults": 5
    },
    "Tavily": {
      "ApiKey": "",
      "SearchDepth": "advanced", // "basic" or "advanced"
      "MaxResults": 5,
      "IncludeAnswer": true
    },
    "PageAgent": {
      "Headless": false,
      "UseSystemProfile": true,
      "UseProfileCopy": false,
      "KillConflictingBrowser": true,
      "UserDataDir": "C:\\Users\\YourName\\AppData\\Local\\Google\\Chrome\\User Data"
    }
  }

}
