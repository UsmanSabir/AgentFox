<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── The community trading plugin: an ENTRY plugin, and nothing more ──────
       This project exists to be discovered. The host's loader scans plugins/ and treats a DLL with
       a sibling .deps.json as an entry assembly (see Agent/Program.cs), and it registers a plugin's
       IChannelProvider types only when their assembly matches an enabled module's assembly — which
       is why the channel PROVIDER must live here even though the channel implementation lives in
       TradingAgent.Core.

       Everything else — broker, market data, analysis, risk, TradingManager, persistence, tools,
       workers, endpoints, and the dashboard bundle — is in TradingAgent.Core, which a separately
       licensed premium entry plugin composes exactly the way TradingAgentModule does. The two entry
       plugins are mutually exclusive deployment artifacts; TradingAgentRuntime.AddCore fails startup
       if both are installed. See EDITION_SPLIT_PLAN.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The whole dependency closure must sit beside this DLL: the loader resolves a plugin's
         dependencies through its own .deps.json, and a missing transitive assembly surfaces as a
         runtime FileNotFoundException on first use, not as a build error. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Deploy the plugin (and its dependencies, via CopyLocalLockFileAssemblies) directly into
         the host's plugins/ folder, which PluginLoader scans at AppContext.BaseDirectory/plugins.
         Path is relative to this project and tracks the host's Configuration/TFM. -->
    <OutputPath>..\..\Agent\bin\$(Configuration)\$(TargetFramework)\plugins\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
  </PropertyGroup>

  <!-- ── Plugin web UI ──────────────────────────────────────────────────────
       The trading UI is a SEPARATE npm project (ui/) so its dependencies — charting in
       particular — never enter the host frontend's package.json.

       It builds to ../TradingAgent.Core/wwwroot and is embedded in the CORE assembly, not this one.
       That is deliberate: the dashboard then travels with the engine, so the community entry and a
       premium entry serve the identical bundle and premium extends this UI through data rather than
       by shipping a second page. The EmbeddedResource item and GenerateEmbeddedFilesManifest
       therefore live in TradingAgent.Core.csproj.

       Build with: cd ui && npm ci && npm run build
       A build without a compiled UI still succeeds — TradingAgentRuntime.GetCorePages() then
       contributes no page, and the backend is unaffected. -->

  <ItemGroup>
    <ProjectReference Include="..\..\AgentFox.Plugins\AgentFox.Plugins.csproj" />
    <ProjectReference Include="..\TradingAgent.Core\TradingAgent.Core.csproj" />
  </ItemGroup>

  <!-- No PackageReference of its own: the shim compiles against AgentFox.Plugins and the shared
       framework only, and every package the engine needs arrives transitively from
       TradingAgent.Core. Adding one here would pin a version for the engine from the wrong project. -->

</Project>
