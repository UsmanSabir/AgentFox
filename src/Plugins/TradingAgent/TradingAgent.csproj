<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Deploy the plugin (and its dependencies, via CopyLocalLockFileAssemblies) directly into
         the host's plugins/ folder, which PluginLoader scans at AppContext.BaseDirectory/plugins.
         Path is relative to this project and tracks the host's Configuration/TFM. -->
    <OutputPath>..\..\Agent\bin\$(Configuration)\$(TargetFramework)\plugins\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
    <!-- Required for ManifestEmbeddedFileProvider to serve the plugin's own wwwroot from inside
         TradingAgent.dll (see the UI ItemGroup below). -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <!-- ── Plugin web UI ──────────────────────────────────────────────────────
       The trading UI is a SEPARATE npm project (ui/) so its dependencies — charting in
       particular — never enter the host frontend's package.json. It builds to wwwroot/ and is
       embedded here, so the UI travels inside the plugin DLL exactly as the host's SPA travels
       inside the host assembly. TradingAgentModule serves it via IPluginUiContributor, and the
       host mounts it at /ext/trading.

       Build with: cd ui && npm ci && npm run build
       The condition means a build without a compiled UI still succeeds — the plugin then simply
       contributes no page, and the backend is unaffected. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Harness" />
    <PackageReference Include="PuppeteerSharp" />
    <!-- Must match the version the HOST resolves (currently 10.6.0). PluginLoadContext delegates
         all Microsoft.Extensions.* assemblies to the host's default load context so plugin and host
         share one IChatClient type; .NET roll-forward only binds UP, so a plugin built against a
         HIGHER version than the host ships fails with FileNotFoundException at OnAgentReadyAsync. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <!-- BackgroundService / IHostedService for the take-profit retry worker. Pinned to the host's
         Microsoft.Extensions.* version (10.0.9); PluginLoadContext delegates these to the host's load
         context at runtime, and roll-forward only binds UP, so never build against a higher version. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- ManifestEmbeddedFileProvider, for serving the embedded plugin UI. Same pinning rule as the
         other Microsoft.Extensions.* references above: PluginLoadContext delegates these to the
         host's load context, so never build against a higher version than the host ships. -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Override Microsoft.Data.Sqlite's minimum native bundle with the maintained release;
         2.1.11 is deprecated and affected by GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AgentFox.Plugins\AgentFox.Plugins.csproj" />
    <!-- The trading engine. This project is only the ENTRY plugin: the assembly the host's loader
         discovers (it is the one with a .deps.json) and the assembly channel providers must live in.
         Everything else — broker, market data, analysis, risk, TradingManager, persistence, tools,
         workers, endpoints — lives in TradingAgent.Core, which a premium entry plugin composes the
         same way this one does. TradingAgent.Core deliberately has no OutputPath of its own; see the
         comment at the top of TradingAgent.Core.csproj for why that matters to the loader. -->
    <ProjectReference Include="..\TradingAgent.Core\TradingAgent.Core.csproj" />
  </ItemGroup>

</Project>
