<Project>
  <!--
    Central Package Management: every PackageReference version lives here so versions cannot
    drift between projects (the Microsoft.Agents.AI.Harness version was previously repeated in
    three csproj files).

    Preview-bump policy (HARNESS_AGENT_ROADMAP.md, Phase 0): Microsoft.Agents.AI.Harness is a
    PREVIEW package. Bumping it is a deliberate change, not a routine update — take a new
    preview only with a green gate of: full solution build, the Harness adapter compatibility
    tests, and the Phase 0 policy-bypass tests. Keep the Microsoft.Agents.AI.* family on
    matching versions when bumping.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Agent Framework family — keep versions aligned when bumping -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.15.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Anthropic" Version="1.0.0-rc5" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.15.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.15.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.15.0" />
    <!-- LLM providers and AI abstractions -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Google.GenAI" Version="1.15.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.1" />
    <PackageVersion Include="OllamaSharp" Version="5.4.27" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <!-- Microsoft.Extensions.* — pinned to the host's version; plugins must never build
         against a higher version than the host ships (PluginLoadContext delegates these
         to the host's load context and roll-forward only binds UP) -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <!-- Storage -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <!-- Channels, tooling, misc -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Discord.Net" Version="3.20.1" />
    <PackageVersion Include="FastBertTokenizer" Version="1.0.28" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.4.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="PrettyPrompt" Version="6.0.4" />
    <PackageVersion Include="PuppeteerSharp" Version="25.3.4" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.9.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.2" />
    <PackageVersion Include="MSTest" Version="4.3.2" />
  </ItemGroup>
</Project>